node_modules/
dist/
*.local
.DS_Store

# Local inspiration/reference downloads; not project assets for redistribution.
/car inspiration/
/track inspiration/

# Generated captures and test reports. Runtime asset textures stay tracked.
/screenshots/
/artifacts/
/test-results/
/playwright-report/
/.playwright-cli/
# Blender's recovery backups stay local; the editable .blend is tracked.
/assets/cars/*.blend[0-9]
/assets/tracks/**/*.blend[0-9]
*.log

# Local credentials/configuration; sanitized examples may be committed.
.env
.env.*
!.env.example

# AI assistants' local state. Claude Code and Codex both work in this tree;
# their scratch, attachments and per-machine settings stay on the machine.
# The one shared file is .claude/launch.json, which tells the Claude desktop
# app's preview how to start the dev server.
/.claude/*
!/.claude/launch.json
/.codex/
/.codex-remote-attachments/

# The player's own music, and the manifest listing it, stay on their machine.
# Only the folder's README is tracked. See public/assets/music/README.md.
/public/assets/music/*
!/public/assets/music/README.md

# Local Midnight Club captures for reference; Rockstar content, never committed.
/mc inspiration/
