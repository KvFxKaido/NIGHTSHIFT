{
  "name": "nightshift",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "frontages:generate": "node --experimental-strip-types scripts/generate-frontages.ts",
    "test:frontage-editor": "node scripts/test-frontage-editor.mjs",
    "track:guide": "node scripts/export-course-guide.mjs",
    "track:export": "node --env-file-if-exists=.env scripts/export-track.mjs",
    "assets:track": "node scripts/optimize-track.mjs",
    "car:export": "node --env-file-if-exists=.env scripts/export-car.mjs",
    "music:scan": "node scripts/scan-music.mjs",
    "assets:car": "node scripts/optimize-car.mjs",
    "assets:bulwark": "node scripts/optimize-car.mjs --car=ns-bulwark-01",
    "dev": "node scripts/scan-music.mjs && vite",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:facade": "node scripts/test-facade-menu.mjs",
    "test:cinder": "node scripts/test-cinder-parts.mjs",
    "test:garage-shots": "node scripts/test-garage-cutscenes.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "district:critique": "node --experimental-strip-types --no-warnings scripts/critique-district.ts",
    "laps": "node --experimental-strip-types --no-warnings scripts/lap-summary.ts",
    "laps:compare": "node --experimental-strip-types --no-warnings scripts/lap-compare.ts",
    "pace": "node --experimental-strip-types --no-warnings scripts/calibrate-pace.ts",
    "cars": "node --experimental-strip-types --no-warnings scripts/car-card.ts",
    "cars:stats": "node --experimental-strip-types --no-warnings scripts/car-stats.ts",
    "golden": "node --experimental-strip-types --no-warnings scripts/golden.ts",
    "alder:critique": "node --experimental-strip-types --no-warnings scripts/critique-alder.ts",
    "alder:turf": "node --experimental-strip-types --no-warnings scripts/turf-report.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@types/three": "^0.185.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
