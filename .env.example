# Local tool paths for the Blender asset pipeline. Copy to `.env` and edit.
# `.env` is gitignored; this example is tracked.
#
# NS-01 and Blackglass were authored in Blender 5.3.0 Alpha. The READMEs in
# assets/cars/ and assets/tracks/blackglass/ do not claim compatibility with
# older builds, so point this at that build or a newer one.
#
# Used by `pnpm car:export` and `pnpm track:export`.
BLENDER_EXE='C:\path\to\blender.exe'
